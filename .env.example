# Copia este fichero a .env.local. Todo es opcional en desarrollo.

# Postgres (Neon, Supabase, Vercel Postgres…). Sin esta variable se usa PGlite en .data/pglite.
# En Vercel es obligatoria. Usa la URL del pooler si tu proveedor la ofrece.
# DATABASE_URL=postgres://usuario:contraseña@host:5432/basededatos

# Vercel Blob para las imágenes subidas. Sin esta variable se guardan en .data/uploads.
# BLOB_READ_WRITE_TOKEN=
